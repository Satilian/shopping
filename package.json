{
  "name": "shopping-list",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && node --env-file=.env scripts/start-dev.mjs",
    "dev:web": "rsbuild dev --environment web",
    "start": "node dist/server/main.js",
    "build": "rsbuild build && node scripts/build-pwa.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-fastify": "11.2.10",
    "@satilian/router": "2.0.0",
    "@satilian/ui-kit": "1.0.0",
    "fastify": "5.12.8",
    "openid-client": "6.9.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rsbuild/core": "2.3.3",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
